# Copy to contracts/.env (git-ignored). Foundry loads it automatically.

# --- deployer -----------------------------------------------------------------------------------------------------
# Deployer key (0x-prefixed). Needs a little Arbitrum Sepolia ETH (faucets: https://faucet.quicknode.com/arbitrum/sepolia,
# https://www.alchemy.com/faucets/arbitrum-sepolia). Not needed for the local anvil chain.
PRIVATE_KEY=

# Game server / gas relayer address. It records match results (mints NOVA) and pays the gas for players' purchases.
# Default: the deployer itself (simplest: one key, fund it once). If you use a separate key, fund it with ETH too
# (or set RELAYER_TOPUP_MILLIETH=20 to have the deploy script send it 0.02 ETH).
RELAYER_ADDRESS=
RELAYER_TOPUP_MILLIETH=0

# --- RPC + verification ---------------------------------------------------------------------------------------------
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# Etherscan API v2 key (one key works for Arbiscan too): https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# --- economy (whole NOVA) — change any time later with script/Configure.s.sol -------------------------------------
CAR_PRICE=100
PAINT_PRICE=20
# NOVA minted per 100 match points (a goal is 100 points, a touch 2): 50 → 0.5 NOVA per point
REWARD_PER_100_POINTS=50
MAX_POINTS_PER_MATCH=3000
MATCH_COOLDOWN=60
