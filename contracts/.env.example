# Copy to contracts/.env (git-ignored). Foundry loads it automatically.

# --- deployer -----------------------------------------------------------------------------------------------------
# Deployer key (0x-prefixed). Needs a little Arbitrum Sepolia ETH (faucets: https://faucet.quicknode.com/arbitrum/sepolia,
# https://www.alchemy.com/faucets/arbitrum-sepolia). Not needed for the local anvil chain.
PRIVATE_KEY=

# Game server / gas relayer address. It records match results (mints NOVA) and pays the gas for players' purchases.
# Its key lives on the web server, so RECOMMENDED: give it its own key instead of the admin/deployer one:
#   cast wallet new          → put the address here, the private key in frontend/.env.local (RELAYER_PRIVATE_KEY)
#   RELAYER_TOPUP_MILLIETH=20 → the deploy script sends it 0.02 ETH for gas
# Left empty, the deployer itself is the relayer (simplest for a quick demo, but the server then holds the admin key).
RELAYER_ADDRESS=
RELAYER_TOPUP_MILLIETH=0

# --- RPC + verification ---------------------------------------------------------------------------------------------
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# Etherscan API v2 key (one key works for Arbiscan too): https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# --- economy (whole NOVA) — change any time later with script/Configure.s.sol -------------------------------------
CAR_PRICE=100
PAINT_PRICE=20
# NOVA minted per 100 match points (a goal is 100 points, a touch 2): 100 → 1 NOVA per point
REWARD_PER_100_POINTS=100
MAX_POINTS_PER_MATCH=3000
MATCH_COOLDOWN=60
