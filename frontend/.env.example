# Copy to frontend/.env.local (git-ignored). Only VITE_* values reach the browser bundle.

# --- web app (build time) ------------------------------------------------------------------------------------------
# 31337 = local anvil (default for `npm run dev`), 421614 = Arbitrum Sepolia (default for `npm run build`), 42161 = Arbitrum One
VITE_CHAIN_ID=421614
# Browser JSON-RPC (default: the chain's public RPC; local: the dev server's /rpc proxy to anvil)
# VITE_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# Relayer base URL when it is hosted somewhere else than the game (default: same origin /api)
# VITE_RELAYER_URL=https://novaball-relayer.example.com/api

# --- relayer (server side: `npm run dev`, `npm run preview`, `npm start`) -------------------------------------------
# Key of the address that holds GAME_SERVER_ROLE on NovaArena (RELAYER_ADDRESS at deploy time; default: the deployer).
# It pays the gas for match rewards and players' purchases, so keep it funded with a little ETH.
# Not needed for the local chain (anvil account #1 is used).
RELAYER_PRIVATE_KEY=
# Server-side RPC (default: the chain's public RPC)
# RPC_URL=
# PORT=8787
