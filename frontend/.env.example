# Copy to frontend/.env.local (git-ignored). All optional; read at build time (only VITE_* values reach the bundle).

# testnet = Arbitrum Sepolia (default when unset), local = anvil (`npm run dev:local` sets it), mainnet = Arbitrum One
VITE_NETWORK=testnet
# Browser JSON-RPC (default: the chain's public RPC; local: the dev server's /rpc proxy to anvil)
# VITE_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# Public URL of the deployed game, for the canonical link, Open Graph / Twitter image URLs, structured data and
# sitemap.xml (default on Vercel: the project's production domain; without one these URL-only tags are left out)
# VITE_SITE_URL=https://novaball.example
